// Cloudflare Worker + Durable Object: the DirectorLink relay on https://api.directorlink.io.
// Protocol: docs/RELAY.md. One Durable Object per home (HomeRelay, SQLite-backed, named by
// home_id) holds the driver's WebSocket. Deployed by hand for now (see README.md):
//   npx wrangler@4 deploy
//   npx wrangler@4 secret put TEST_TOKEN      (the version 0 test endpoints)
// `wrangler dev` reads TEST_TOKEN, and optionally REQUEST_TIMEOUT_MS, from cloud/.dev.vars.
{
  "name": "directorlink-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "HOME_RELAY", "class_name": "HomeRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HomeRelay"] }
  ],
  // Accounts (accounts.js). The database id is not a secret; migrations: migrations/.
  "d1_databases": [
    { "binding": "DB", "database_name": "directorlink", "database_id": "413f0c4a-c1c8-458e-9364-286bf24f179f", "migrations_dir": "migrations" }
  ],
  // GOOGLE_CLIENT_SECRET is a secret (npx wrangler@4 secret put GOOGLE_CLIENT_SECRET).
  "vars": {
    "GOOGLE_CLIENT_ID": "1034749624411-vfj1im8dc42utkvl6lfiv3hs49mcna2s.apps.googleusercontent.com",
    "APP_ORIGINS": "https://app.directorlink.io",
    "PUBLIC_URL": "https://api.directorlink.io"
  },
  "routes": [
    { "pattern": "api.directorlink.io", "custom_domain": true }
  ]
}

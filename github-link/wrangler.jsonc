// Cloudflare Worker: https://github.directorlink.io, the short link to the source code on GitHub
// (worker.js answers every request with a redirect into the repository).
// Deployed by .github/workflows/deploy.yml (wrangler deploy) after the owner approves (ADR-075).
{
  "name": "directorlink-github",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "github.directorlink.io", "custom_domain": true }
  ]
}

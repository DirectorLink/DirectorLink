# Local build/temp files
build/
*.tmp
.DS_Store
Thumbs.db
dist/
__pycache__/

# Local tool configuration (it holds account details) and secrets: never committed
# (scripts/check_repo.py fails the build if they are).
.claude.json
.claude/
.dev.vars
.env
.env.*
*.p8
*.pem
*.key
# The one exception: public root certificates the driver trusts for the relay (no secret).
!driver/certs/directorlink-roots.pem
